---
import '../../../styles/scroll.css';
import '../../../styles/cards.css';
import { Image } from "astro:assets";
import TechLabel from '../labels/TechLabel.astro';

const { project } = Astro.props;

const {
  title,
  description,
  github,
  image,
  repository,
  tags
} = project;
---

<article class="card scrollCard">
  <h3 class="text-lg sm:text-2xl font-bold text-white">
    {title}
  </h3>

  <div class="flex flex-col md:flex-row justify-between gap-6">
    <div
      class="
        w-full md:w-auto
        shrink-0
        flex items-center justify-center
      "
    >
      <Image
        src={image}
        alt={`Captura de pantalla de ${title}`}
        loading="lazy"
        class="
          w-full max-w-75 h-45
          md:w-75 md:h-75
          object-cover rounded-3xl
          transition duration-300
          hover:border-2 hover:border-white
        "
      />
    </div>

    <div class="flex flex-col justify-center flex-1">
      <p class="text-sm md:text-base text-white/80 mb-4 leading-relaxed">
        {description}
      </p>

      <div class="w-full flex flex-wrap gap-3 mb-6">
        {tags.map((tag) => (
          <TechLabel
            icon={tag.icon}
            label={tag.label}
            color={tag.color}
          />
        ))}
      </div>


      <a
        href={github}
        target="_blank"
        rel="noopener noreferrer"
        class="
          inline-flex w-fit
          text-sm md:text-base font-semibold
          border px-4 py-2 md:px-5 md:py-2.5
          rounded-xl
          text-gray-300 bg-gray-800 border-gray-500
          hover:bg-white/20 hover:scale-110 transition-all duration-400
        "
      >
        {repository}
      </a>
    </div>
  </div>
</article>