---
const { education } = Astro.props;
import '../../../styles/cards.css';
import '../../../styles/scroll.css';
---

<div class="w-full flex items-center justify-center relative">
  <div class="card scrollCard">
    <h3 class="text-xl sm:text-2xl font-bold text-cyan-400">
      {education.name}
    </h3>

    <p class="text-gray-100 text-lg font-medium text-gray-500">
      {education.organization}
    </p>
    <p class="text-md font-light text-gray-100">
      {education.date}
    </p>

  </div>
</div>