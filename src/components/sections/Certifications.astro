---
import es from "../../langs/es.json";
import en from "../../langs/en.json";

const lang = Astro.currentLocale || "es";

const t = lang === "es" ? es : en;
---
<section
  id="certifications"
  class="relative min-h-screen w-full flex flex-col items-center pt-20 px-4 mt-20"
>
  <h2 class="text-2xl sm:text-4xl font-bold text-white mb-12 text-start">
    {t.certifications.title}
  </h2>

  <div class="w-full flex flex-col gap-6 items-center">
    {t.certifications.items.map((cert, index) => (
      <div
        class="p-4 max-w-[720px] w-full flex flex-col gap-2 px-10 py-4 mb-6 rounded-3xl bg-[#1c2430]/40 border border-gray-700 transition-all duration-700 ease-out transform"
      >
        <h3 class="text-xl sm:text-2xl font-semibold text-white">
          {cert.name}
        </h3>

        <p class="text-gray-500 mt-1">
          {cert.date}
        </p>

        <p class="text-gray-300">
          {cert.organization}
        </p>

        <p class="text-white mt-2">
          {cert.description}
        </p>
      </div>
    ))}
  </div>
</section>

