---
import es from "../../langs/es.json";
import en from "../../langs/en.json";

const { lang = "es" } = Astro.props;

const t = lang === "es" ? es : en;

const identityText = t.about.identity.text;
const identityHighlights = t.about.identity.highlight || [];

const focusText = t.about.focus.text;
const focusHighlights = t.about.focus.highlight || [];

const valuesText = t.about.values.text;
const valuesHighlights = t.about.values.highlight || [];

const getCVFile = () => {
  return lang === "es"
    ? "/docs/Emmanuel_Martinez_Fullstack_Developer_cv.pdf"
    : "/docs/Emmanuel_Martinez_Fullstack_Developer_en_cv.pdf";
};

const highlightText = (text, highlights = []) => {
  let result = text;

  highlights.forEach((highlight) => {
    result = result.replace(
      new RegExp(`(${highlight})`, "gi"),
      `<span class="text-cyan-400 font-semibold">$1</span>`,
    );
  });

  return result;
};
---

<section id="about" class="relative w-full flex flex-col items-center py-20">
  <h2 class="text-2xl sm:text-4xl font-bold text-white mb-12 text-start">
    {t.about.title}
  </h2>
  <div class="flex flex-col sm:flex-row max-w-[720px] gap-4 items-center">
    <div class="text-base sm:pl-6 px-4 text-white">
      <p>{identityText}</p>
      <br />
      <p>{focusText}</p>
      <br />
      <p>{valuesText}</p>
      <a
        href={getCVFile()}
        download
        class="text-white inline-block mt-4 bg-black/30 px-6 py-2 border border-white rounded-lg hover:bg-white/20 transition-colors duration-200"
      >
        {lang === "es" ? "Descargar CV" : "Download CV"}
      </a>
    </div>
  </div>
</section>
