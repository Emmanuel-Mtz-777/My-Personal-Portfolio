---
import es from "../../langs/es.json";
import en from "../../langs/en.json";
import {languajes, frontend, backend, databases, tools} from "../../utils/data/StackData.js";
import TechCard from "../ui/cards/TechCard.astro";

const { lang = "es" } = Astro.props;

const t = lang === "es" ? es : en;

---

<section id="skills" class="relative w-full flex flex-col items-center pt-20">

  <div class="w-full max-w-4xl">

  <h2 class="text-2xl sm:text-4xl font-bold text-white mb-12">
    {t.stack.title}
  </h2>
  </div>


  <div class="w-full max-w-4xl flex flex-col gap-6 px-4">
    <TechCard
      title={t.stack.lang}
      items={languajes}
      cols="grid-cols-3 sm:grid-cols-5"
    />

    <div class="flex flex-col sm:flex-row gap-4">

      <TechCard
        title={t.stack.frontend}
        items={frontend}
        cols="grid-cols-3 sm:grid-cols-4"
        class="w-full sm:w-2/3"
      />

      <TechCard
        title={t.stack.db}
        items={databases}
        cols="grid-cols-3 sm:grid-cols-2"
        class="w-full sm:w-1/3"
      />
    </div>

    <div class="flex flex-col sm:flex-row gap-4">
      <TechCard
        title={t.stack.backend}
        items={backend}
        cols="grid-cols-3"
        class="w-full sm:w-1/2"
      />
      <TechCard
        title={t.stack.tools}
        items={tools}
        cols="grid-cols-3"
        class="w-full sm:w-1/2"
      />
    </div>
  </div>
</section>
