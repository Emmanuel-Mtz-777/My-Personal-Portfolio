---
import es from "../../langs/es.json";
import en from "../../langs/en.json";
import CertificateCard from "../ui/cards/CertificateCard.astro";
import EducationCard from "../ui/cards/EducationCard.astro";

const lang = Astro.currentLocale || "es";

const t = lang === "es" ? es : en;
---
<section
  id="education"
  class="relative min-h-screen w-full flex flex-col items-center pt-20 px-4 mt-20"
>
  <h2 class="text-2xl sm:text-4xl font-bold text-white mb-12 text-start">
    {t.certifications.title}
  </h2>
  <div class="w-full max-w-4xl">
    <EducationCard education={t.education} />
  </div>

  <div class="w-full max-w-4xl">
    <CertificateCard certifications={t.certifications} />
  </div>
</section>

         


