---
import es from "../../langs/es.json";
import en from "../../langs/en.json";
import "../../styles/scroll.css";
import "../../styles/cards.css";

const { lang = "es" } = Astro.props;

const t = lang === "es" ? es : en;

const experiences = t.experience.items || [];
---

<section
  id="experience"
  class="relative w-full flex flex-col items-center pt-20 px-4"
>
  <h2 class="text-2xl sm:text-4xl font-bold text-white mb-12 text-start">
    {t.experience.title}
  </h2>

  <div class="w-full flex flex-col gap-6 items-center rounded-lg p-6">
    
    {experiences.map((exp) => (
      <div class="w-full flex items-center justify-center relative">
        <div class="card scrollCard">
        
        <h3 class="text-xl sm:text-2xl font-semibold text-white">
          {exp.position}
        </h3>

        <p class="text-gray-100 text-lg font-medium">
          {exp.company}
        </p>

        <p class="text-gray-300 text-sm">
          {exp.duration}
        </p>

        <ul class="mt-4 list-disc pl-5 text-gray-300 space-y-2">
          {exp.description.map((item) => (
            <li class="leading-relaxed">
              {item}
            </li>
          ))}
        </ul>
      </div>
      </div>

    ))}
  </div>
</section>

