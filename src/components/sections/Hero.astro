---
import es from "../../langs/es.json";
import en from "../../langs/en.json";
import Mail from "../icons/Mail";
import Linkedin from "../icons/Linkedin";
import GitHub from "../icons/Github";
import { trackEvent } from "../../utils/analiticsTrackEvent.js";
import "../../styles/Hero.css";
import { Image } from "astro:assets";
import Particles from "../effects/Particles.jsx";
import Yo from "../../assets/img/Yo.webp";
import "../../styles/Hero.css";
import SocialButton from "../ui/buttons/SocialButton.astro";

const lang = Astro.currentLocale || "es";

const t = lang === "es" ? es : en;

const getCVFile = () => {
  return lang === "es"
    ? "/docs/Emmanuel_Mtz_CV.pdf"
    : "/docs/Emmanuel_Mtz_CV_En.pdf";
};
---

<section
  id="home"
  class="relative min-h-dvh w-full flex items-center justify-center px-4 pt-20 sm:px-6 overflow-hidden"
>
  <div
    class="flex flex-col-reverse md:flex-row items-center justify-between gap-12 w-full max-w-6xl"
  >
    <div class="flex flex-col text-left items-start gap-6 text-white max-w-2xl">
      <h1
        class="text-2xl sm:text-3xl md:text-5xl font-semibold text-stone-400 lg:whitespace-nowrap"
      >
        {t.hero.greeting}
      </h1>

      <h2 class="text-2xl sm:text-4xl font-semibold text-white">
        {t.hero.role}
      </h2>

      <div class="text-base sm:text-lg space-y-4">
        <p>{t.hero.description}</p>

        <p class="text-sm opacity-80">{t.hero.location}</p>
      </div>
      <div class="flex flex-wrap justify-center lg:justify-start gap-4">
        <SocialButton href="https://github.com/Emmanuel-Mtz-777" label="GitHub">
          <GitHub className="w-5 h-5" />
        </SocialButton>

        <SocialButton
          href="https://www.linkedin.com/in/humberto-emmanuel-rosales-martinez-588002316/"
          label="LinkedIn"
        >
          <Linkedin className="w-5 h-5" />
        </SocialButton>

        <SocialButton href="mailto:hemmanuelmtz777@gmail.com" label="Gmail">
          <Mail className="w-5 h-5" />
        </SocialButton>
      </div>

      <div
        class="flex pt-2 md:flex-wrap md:gap-6 justify-evenly md:justify-start w-full font-semibold"
      >
        <a
          href={getCVFile()}
          download
          class="bg-white text-black px-6 py-3 rounded-xl transition-all duration-400 hover:bg-gray-800 hover:text-white hover:border hover:border-white hover:scale-110"
        >
          Descargar CV
        </a>

        <a
          href={getCVFile()}
          target="_blank"
          rel="noopener noreferrer"
          class="border border-white px-6 py-3 rounded-xl hover:bg-white/20 hover:scale-110 transition-all duration-400"
        >
          Ver CV
        </a>
      </div>
    </div>
    <div class="relative w-30 lg:w-80 sm:w-250">
      <div class="absolute inset-0 w-full h-full hidden md:block">
        <Particles
          client:load
          particleColors={["#06B6D4", "#3B82F6", "#9333EA", "#EC4899"]}
          particleCount={200}
          particleSpread={10}
          speed={0.6}
          particleBaseSize={120}
          alphaParticles={false}
          disableRotation={false}
          pixelRatio={1}
        />
      </div>

      <Image
        src={Yo}
        alt="Emmanuel Martinez"
        width={320}
        height={420}
        loading="eager"
        fetchpriority="high"
        class="relative z-10 w-full rounded-2xl me"
      />
    </div>
  </div>
</section>
);

